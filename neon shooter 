</head>
<body class="h-screen w-screen flex flex-col justify-between p-2 md:p-4 bg-gray-950 select-none">

    <!-- HUD SUPERIORE -->
    <header class="w-full max-w-4xl mx-auto neon-border bg-gray-900/80 rounded-xl p-3 flex justify-between items-center z-10 backdrop-blur-md">
        <div class="flex flex-col items-start">
