    <!-- HUD INFERIORE (Barre Stato) -->
    <footer class="w-full max-w-4xl mx-auto neon-border bg-gray-900/80 rounded-xl p-3 flex flex-col gap-2 z-10 backdrop-blur-md">
        <!-- Barra Integrità -->
        <div class="flex items-center gap-2">
            <span class="text-xs text-pink-400 font-bold w-20 tracking-wider">INTEGRITÀ:</span>
            <div class="flex-1 h-3 bg-gray-800 rounded-full overflow-hidden border border-pink-900">
                <div id="hullBar" class="h-full bg-gradient-to-r from-pink-600 to-rose-400 transition-all duration-200 w-full"></div>
            </div>
        </div>

        <!-- Barra Scudo -->
        <div class="flex items-center gap-2">
            <span class="text-xs text-cyan-400 font-bold w-20 tracking-wider">SCUDO:</span>
            <div class="flex-1 h-3 bg-gray-800 rounded-full overflow-hidden border border-cyan-900">
                <div id="shieldBar" class="h-full bg-gradient-to-r from-cyan-600 to-teal-300 transition-all duration-200 w-full"></div>
            </div>
        </div>

        <!-- Barra Overdrive -->
        <div class="flex items-center gap-2">
            <span class="text-xs text-yellow-400 font-bold w-20 tracking-wider">OVERDRIVE:</span>
            <div class="flex-1 h-3 bg-gray-800 rounded-full overflow-hidden border border-yellow-900">
                <div id="overdriveBar" class="h-full bg-gradient-to-r from-amber-500 to-yellow-300 transition-all duration-200 w-0"></div>
            </div>
        </div>
    </footer>

    <script>
        // --- SINTETIZZATORE AUDIO (Senza file esterni) ---
        class SoundFX {
            constructor() {
                this.ctx = null;
            }
            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }
            playLaser() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(800, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.15);
            }
            playExplosion() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'square';
                osc.frequency.setValueAtTime(150, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(20, this.ctx.currentTime + 0.3);
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.3);
            }
            playPowerup() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(1200, this.ctx.currentTime + 0.25);
                gain.gain.setValueAtTime(0.25, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.25);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.25);
            }
        }

        const soundFX = new SoundFX();

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // Elementi Interfaccia
        const scoreText = document.getElementById('scoreText');
        const levelText = document.getElementById('levelText');
        const multiplierText = document.getElementById('multiplierText');
        const highScoreText = document.getElementById('highScoreText');
        const hullBar = document.getElementById('hullBar');
        const shieldBar = document.getElementById('shieldBar');
        const overdriveBar = document.getElementById('overdriveBar');
        const gameMenu = document.getElementById('gameMenu');
        const menuTitle = document.getElementById('menuTitle');
        const menuDesc = document.getElementById('menuDesc');
        const startBtn = document.getElementById('startBtn');

        // Ridimensionamento dinamico del Canvas
        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Stato di Gioco
        let gameRunning = false;
        let score = 0;
        let highScore = localStorage.getItem('cyber_highscore') || 0;
        let level = 1;
        let multiplier = 1.0;
        let overdriveValue = 0;
        let lastTime = 0;
        let shootTimer = 0;

        highScoreText.textContent = String(highScore).padStart(6, '0');

        // Giocatore
        const player = {
            x: canvas.width / 2,
            y: canvas.height - 80,
            width: 36,
            height: 36,
            hull: 100,
            maxHull: 100,
            shield: 100,
            maxShield: 100,
            speed: 8,
            targetX: canvas.width / 2,
            targetY: canvas.height - 80
        };

        let lasers = [];
        let enemies = [];
        let particles = [];
        let stars = [];
        let powerups = [];

        // Generazione stelle di sfondo
        for (let i = 0; i < 80; i++) {
            stars.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 2 + 1,
                speed: Math.random() * 2 + 0.5,
                alpha: Math.random()
            });
        }

        // Eventi di Controllo (Mouse / Touch)
        function handlePointerMove(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            
            player.targetX = clientX - rect.left;
            player.targetY = clientY - rect.top;
        }

        canvas.addEventListener('mousemove', handlePointerMove);
        canvas.addEventListener('touchmove', (e) => {
            e.preventDefault();
            handlePointerMove(e);
        }, { passive: false });

        startBtn.addEventListener('click', () => {
            soundFX.init();
            resetGame();
            gameMenu.classList.add('hidden');
            gameRunning = true;
            requestAnimationFrame(gameLoop);
        });

        function resetGame() {
            score = 0;
            level = 1;
            multiplier = 1.0;
            overdriveValue = 0;
            player.hull = 100;
            player.shield = 100;
            player.x = canvas.width / 2;
            player.y = canvas.height - 80;
            player.targetX = player.x;
            player.targetY = player.y;

            lasers = [];
            enemies = [];
            particles = [];
            powerups = [];

            updateHUD();
        }

        function updateHUD() {
            scoreText.textContent = String(Math.floor(score)).padStart(6, '0');
            levelText.textContent = `LVL ${level}`;
            multiplierText.textContent = `x${multiplier.toFixed(1)}`;
            hullBar.style.width = `${Math.max(0, player.hull)}%`;
            shieldBar.style.width = `${Math.max(0, player.shield)}%`;
            overdriveBar.style.width = `${Math.min(100, overdriveValue)}%`;
        }

        function spawnEnemy() {
            const types = ['standard', 'fast', 'heavy'];
            const type = types[Math.floor(Math.random() * types.length)];
            
            let size = 30;
            let hp = 1;
            let speed = 2 + Math.random() * 1.5 + level * 0.2;
            let color = '#ec4899'; // Pink

            if (type === 'fast') {
                size = 22;
                speed += 2;
                color = '#38bdf8'; // Cyan
            } else if (type === 'heavy') {
                size = 45;
                hp = 3;
                speed *= 0.7;
                color = '#eab308'; // Yellow
            }

            enemies.push({
                x: Math.random() * (canvas.width - size * 2) + size,
                y: -size,
                size: size,
                hp: hp,
                maxHp: hp,
                speed: speed,
                color: color,
                type: type
            });
        }

        function createExplosion(x, y, color) {
            for (let i = 0; i < 15; i++) {
                particles.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 6,
                    vy: (Math.random() - 0.5) * 6,
                    size: Math.random() * 3 + 1,
                    color: color,
                    life: 1.0,
                    decay: Math.random() * 0.04 + 0.02
                });
            }
        }

        function update(deltaTime) {
            if (!gameRunning) return;

            // Ricarica automatica scudo nel tempo
            if (player.shield < player.maxShield) {
                player.shield = Math.min(player.maxShield, player.shield + 0.05);
            }

            // Movimento fluido del giocatore verso la posizione del cursore
            if (player.x !== null && player.targetX !== null) {
                player.x += (player.targetX - player.x) * 0.2;
                player.y += (player.targetY - player.y) * 0.2;

                // Limiti dello schermo per il giocatore
                player.x = Math.max(player.width, Math.min(canvas.width - player.width, player.x));
                player.y = Math.max(player.height, Math.min(canvas.height - player.height, player.y));
            }

            // Sparo Automatico
            shootTimer += deltaTime;
            if (shootTimer > 0.15) {
                shootTimer = 0;
                lasers.push({
                    x: player.x,
                    y: player.y - player.height / 2,
                    speed: 12,
                    color: '#06b6d4'
                });
                soundFX.playLaser();
            }

            // Gestione Stelle Sfondo
            stars.forEach(star => {
                star.y += star.speed;
                if (star.y > canvas.height) {
                    star.y = 0;
                    star.x = Math.random() * canvas.width;
                }
            });

            // Gestione Proiettili (Null-Safety)
            for (let i = lasers.length - 1; i >= 0; i--) {
                const l = lasers[i];
                if (!l || l.x == null || l.y == null) {
                    lasers.splice(i, 1);
                    continue;
                }
                l.y -= l.speed;
                if (l.y < -10) {
                    lasers.splice(i, 1);
                }
            }

            // Generazione Nemici
            if (Math.random() < 0.03 + (level * 0.005)) {
                spawnEnemy();
            }

            // Gestione Nemici e Collisioni
            for (let i = enemies.length - 1; i >= 0; i--) {
                const enemy = enemies[i];

                // CONTROLLO FONDAMENTALE DI SICUREZZA PER EVITARE: Cannot read properties of null (reading 'x')
                if (!enemy || enemy.x == null || enemy.y == null) {
                    enemies.splice(i, 1);
                    continue;
                }

                enemy.y += enemy.speed;

                // Collisione Proiettile - Nemico
                for (let j = lasers.length - 1; j >= 0; j--) {
                    const laser = lasers[j];
                    if (!laser || laser.x == null || laser.y == null) continue;

                    const dx = laser.x - enemy.x;
                    const dy = laser.y - enemy.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);

                    if (dist < enemy.size + 4) {
                        enemy.hp--;
                        lasers.splice(j, 1);
                        createExplosion(laser.x, laser.y, laser.color);

                        if (enemy.hp <= 0) {
                            soundFX.playExplosion();
                            createExplosion(enemy.x, enemy.y, enemy.color);
                            score += 100 * multiplier;
                            overdriveValue = Math.min(100, overdriveValue + 5);

                            // Avanzamento livello ogni 2000 punti
                            if (score >= level * 2000) {
                                level++;
                                multiplier += 0.2;
                            }

                            enemies.splice(i, 1);
                            break;
                        }
                    }
                }

                // Se il nemico esce dallo schermo
                if (enemy && enemy.y > canvas.height + enemy.size) {
                    enemies.splice(i, 1);
                    continue;
                }

                // Collisione Nemico - Giocatore (Defensiva)
                if (enemy && player && player.x != null && player.y != null) {
                    const pdx = enemy.x - player.x;
                    const pdy = enemy.y - player.y;
                    const pdist = Math.sqrt(pdx * pdx + pdy * pdy);

                    if (pdist < enemy.size + player.width / 2) {
                        soundFX.playExplosion();
                        createExplosion(enemy.x, enemy.y, '#f43f5e');

                        const damage = 20;
                        if (player.shield > 0) {
                            player.shield -= damage;
                            if (player.shield < 0) {
                                player.hull += player.shield; // Danno rimanente all'integrità
                                player.shield = 0;
                            }
                        } else {
                            player.hull -= damage;
                        }

                        enemies.splice(i, 1);

                        // Game Over
                        if (player.hull <= 0) {
                            player.hull = 0;
                            gameOver();
                            return;
                        }
                    }
                }
            }

            // Gestione Particelle
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                if (!p || p.x == null) {
                    particles.splice(i, 1);
                    continue;
                }
                p.x += p.vx;
                p.y += p.vy;
                p.life -= p.decay;
                if (p.life <= 0) {
                    particles.splice(i, 1);
                }
            }

            updateHUD();
        }

        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Disegno Griglia Cyberpunk
            ctx.strokeStyle = 'rgba(6, 182, 212, 0.05)';
            ctx.lineWidth = 1;
            const gridSize = 40;
            for (let x = 0; x < canvas.width; x += gridSize) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }

            // Disegno Stelle
            stars.forEach(star => {
                ctx.fillStyle = `rgba(255, 255, 255, ${star.alpha})`;
                ctx.fillRect(star.x, star.y, star.size, star.size);
            });

            // Disegno Proiettili
            lasers.forEach(l => {
                if (!l || l.x == null) return;
                ctx.shadowBlur = 8;
                ctx.shadowColor = l.color;
                ctx.fillStyle = l.color;
                ctx.fillRect(l.x - 2, l.y, 4, 14);
                ctx.shadowBlur = 0;
            });

            // Disegno Nemici
            enemies.forEach(e => {
                if (!e || e.x == null) return;
                ctx.shadowBlur = 10;
                ctx.shadowColor = e.color;
                ctx.fillStyle = e.color;

                ctx.beginPath();
                ctx.arc(e.x, e.y, e.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;
            });

            // Disegno Particelle
            particles.forEach(p => {
                if (!p || p.x == null) return;
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.life;
                ctx.fillRect(p.x, p.y, p.size, p.size);
                ctx.globalAlpha = 1.0;
            });

            // Disegno Giocatore (Navicella Neon)
            if (player && player.x != null && player.y != null) {
                ctx.shadowBlur = 12;
                ctx.shadowColor = '#06b6d4';
                ctx.fillStyle = '#06b6d4';

                ctx.beginPath();
                ctx.moveTo(player.x, player.y - player.height / 2);
                ctx.lineTo(player.x - player.width / 2, player.y + player.height / 2);
                ctx.lineTo(player.x, player.y + player.height / 4);
                ctx.lineTo(player.x + player.width / 2, player.y + player.height / 2);
                ctx.closePath();
                ctx.fill();

                // Effetto Scudo
                if (player.shield > 0) {
                    ctx.strokeStyle = `rgba(6, 182, 212, ${player.shield / 100})`;
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(player.x, player.y, player.width * 0.8, 0, Math.PI * 2);
                    ctx.stroke();
                }

                ctx.shadowBlur = 0;
            }
        }

        function gameOver() {
            gameRunning = false;

            if (score > highScore) {
                highScore = Math.floor(score);
                localStorage.setItem('cyber_highscore', highScore);
                highScoreText.textContent = String(highScore).padStart(6, '0');
            }

            menuTitle.textContent = "GAME OVER";
            menuTitle.className = "font-orbitron text-3xl sm:text-5xl font-black text-rose-500 mb-4 animate-pulse";
            menuDesc.textContent = `Punteggio Finale: ${Math.floor(score)} | Livello Raggiunto: ${level}`;
            startBtn.textContent = "RIPROVA";

            gameMenu.classList.remove('hidden');
        }

        function gameLoop(timestamp) {
            const deltaTime = (timestamp - lastTime) / 1000;
            lastTime = timestamp;

            update(deltaTime || 0.016);
            render();

            if (gameRunning) {
                requestAnimationFrame(gameLoop);
            }
        }
    </script>
</body>
</html>
